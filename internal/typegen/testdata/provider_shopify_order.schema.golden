{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "inferred from one request, best effort",
  "title": "WebhookPayload",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "email": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "total_price": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "financial_status": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "quantity",
          "price"
        ]
      }
    },
    "customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "first_name",
        "last_name"
      ]
    }
  },
  "required": [
    "id",
    "email",
    "created_at",
    "total_price",
    "currency",
    "financial_status",
    "line_items",
    "customer"
  ]
}
