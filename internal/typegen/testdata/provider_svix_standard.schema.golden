{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "inferred from one request, best effort",
  "title": "WebhookPayload",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "plan"
      ]
    }
  },
  "required": [
    "type",
    "timestamp",
    "data"
  ]
}
