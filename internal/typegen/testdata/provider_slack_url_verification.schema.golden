{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "inferred from one request, best effort",
  "title": "WebhookPayload",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "challenge",
    "type"
  ]
}
