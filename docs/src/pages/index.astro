---
// Landing page. A standalone page (not Starlight's splash template) so it can
// have its own nav and footer; the rest of the docs stay on Starlight. It
// follows the same light/dark setting as the docs (localStorage
// "starlight-theme"), with system preference as the fallback.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}getting-started/quickstart/`;
const github = 'https://github.com/sarathsp06/testhooks';
const demo = 'https://testhooks.vercel.app/';

// Keep these identical to the README quick start.
const installs = [
	{
		id: 'binary',
		label: 'Binary',
		cmd: 'curl -fsSL https://raw.githubusercontent.com/sarathsp06/testhooks/main/install.sh | sh && DATABASE_URL=memory testhooks',
		note: 'No database needed. Linux, macOS, Windows; checks the SHA-256.',
	},
	{
		id: 'docker',
		label: 'Docker',
		cmd: 'docker run -d --name testhooks -p 8080:8080 -e DATABASE_URL=memory ghcr.io/sarathsp06/testhooks',
		note: 'No database. Data lives in memory.',
	},
	{
		id: 'snapshot',
		label: 'Docker + snapshot',
		cmd: 'docker run -d --name testhooks -p 8080:8080 -v testhooks-data:/data -e DATABASE_URL=memory -e SNAPSHOT_PATH=/data/testhooks.snapshot ghcr.io/sarathsp06/testhooks',
		note: 'In memory, saved to a volume every 30 s and on shutdown.',
	},
	{
		id: 'compose',
		label: 'Compose + PostgreSQL',
		cmd: 'curl -fsSL https://raw.githubusercontent.com/sarathsp06/testhooks/main/deploy/docker-compose.yml | docker compose -p testhooks -f - up -d',
		note: 'For shared or long-running instances.',
	},
];
const first = installs[0];

// Absolute URLs for canonical, Open Graph and structured data.
const site = (import.meta.env.SITE ?? 'https://sarathsp06.github.io').replace(/\/$/, '');
const pageUrl = `${site}${base}`;
const ogImage = `${pageUrl}og.jpg`;
const title = 'Self-Hosted Webhook Tester | webhook.site Alternative';
const description =
	'Small self-hosted webhook tester: catch a webhook, edit it with a live diff, reply with any status, watch the sender react. Open-source webhook.site alternative.';
const schema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Testhooks',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Linux, macOS, Windows, Docker',
	url: pageUrl,
	description,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	sameAs: [github, demo],
});

// Rolling feature strip under the hero. `plus` marks what webhook.site does
// not offer (checked against its public docs, October 2026).
const features = [
	{ t: 'Your localhost answers the sender', plus: true },
	{ t: 'Forward to localhost from the tab' },
	{ t: 'Standard Webhooks signature verification', plus: true },
	{ t: 'HMAC and Ed25519 signatures', plus: true },
	{ t: 'Reject bad signatures with 401', plus: true },
	{ t: 'JavaScript transforms, free', plus: true },
	{ t: 'Scripted replies, free', plus: true },
	{ t: 'Live diff before you save', plus: true },
	{ t: 'Try a script on recent traffic', plus: true },
	{ t: 'Request forwarding with retries' },
	{ t: 'Sync or async forwarding' },
	{ t: 'Replay any request' },
	{ t: 'Copy as cURL' },
	{ t: 'Export requests as JSON' },
	{ t: 'Envelope-encrypted secrets, write-only' },
	{ t: 'Browser mode: nothing on disk' },
	{ t: 'No request limit, no expiry', plus: true },
	{ t: 'In-memory mode, no database' },
	{ t: 'PostgreSQL when you want to keep it' },
	{ t: 'REST API and WebSocket' },
	{ t: 'One Go binary, UI embedded' },
	{ t: 'Self-host with scripting', plus: true },
	{ t: 'Rate limiting and trusted proxies' },
	{ t: 'Docker image and Vercel deploy' },
	{ t: 'Apache 2.0' },
];

const check = '<path d="M5 12l5 5L20 7"></path>';
const arrow = '<path d="M1 6h37M33 1l5 5-5 5"></path>';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<link rel="sitemap" href={`${base}sitemap-index.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Testhooks" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content="Testhooks: webhooks, made for humans and for machines" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Testhooks: webhooks, made for humans and for machines" />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={schema} />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
		<script is:inline>
			// Same theme as the docs pages, applied before paint to avoid a flash.
			(() => {
				let t = '';
				try { t = localStorage.getItem('starlight-theme') || ''; } catch {}
				if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<header class="nav-bar">
			<nav class="wrap nav">
				<a href="#top" class="brand">
					<span class="brand-mark">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5BD08F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h5l2-5 3 10 2-5h4"></path></svg>
					</span>
					<span class="brand-name">testhooks</span>
				</a>
				<div class="nav-links">
					<a href="#install" class="nav-link section">Install</a>
					<a href="#overview" class="nav-link section">Overview</a>
					<a href="#features" class="nav-link section">Features</a>
					<a href="#modes" class="nav-link section">Modes</a>
					<a href="#compare" class="nav-link section">Compare</a>
					<a href={demo} class="nav-link">Live demo</a>
					<a href={docs} class="nav-link">Docs</a>
					<a href={github} class="nav-gh">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
						GitHub
					</a>
				</div>
			</nav>
		</header>

		<main>
			<!-- Hero -->
			<section id="top" class="wrap hero">
				<div class="pills">
					<span class="pill"><span class="dot"></span>Open source · Apache 2.0 · Self-hosted</span>
					<a href="#standard" class="pill pill-strong">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"></path><path d="M8.5 12l2.5 2.5L15.5 10"></path></svg>
						Standard Webhooks compatible
					</a>
				</div>
				<h1>Webhooks, made for humans and for machines.</h1>
				<p class="lede">A small tool to test webhooks. Catch one, change its payload, reply with any status, and watch what the sender does next. What takes a paid plan or a CLI elsewhere is one click here, or one curl for your scripts. Self-hosted, open source. When your handler runs on localhost, your browser tab is the tunnel.</p>
				<div class="hero-actions">
					<a href={demo} class="btn btn-primary">Try the live demo</a>
					<a href={docs} class="btn btn-secondary">Read the docs</a>
				</div>
				<ul class="proof" aria-label="At a glance">
					<li><b class="mono">1</b><span>Go binary, UI built in, Apache 2.0</span></li>
					<li><b class="mono">∞</b><span>endpoints and requests, no 7-day expiry</span></li>
					<li><b class="mono">JS</b><span>transforms and scripted replies, free</span></li>
					<li><b class="mono">0</b><span>installs to reach localhost: your tab is the tunnel</span></li>
				</ul>
				<p class="hero-demo-note">No account: create an endpoint on the demo and point any service at its URL.</p>

				<div id="install" class="install">
					<div class="install-head">
						<span class="eyebrow-plain">Or run it locally to try it out</span>
						<div class="seg" role="group" aria-label="Install option" data-tabs="install">
							{installs.map((o, i) => (
								<button type="button" class="seg-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-cmd={o.cmd} data-note={o.note}>{o.label}</button>
							))}
						</div>
					</div>
					<div class="cmd-box">
						<div class="cmd mono"><span class="prompt">$ </span><span data-cmd-text>{first.cmd}</span></div>
						<button type="button" class="copy" aria-label="Copy install command" data-copy>
							<svg class="i-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
							<svg class="i-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5BD08F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />
							<span data-copy-label>Copy</span>
						</button>
					</div>
					<p class="install-note">Then open <a href="http://localhost:8080" class="mono kbd">localhost:8080</a> · <span data-note-text>{first.note}</span></p>
					<p class="install-warn">A local install is for testing: services on the internet can't reach <span class="mono">localhost</span>, so it only gets requests you send from your machine. To receive real webhooks, <a href={`${base}deployment/production/`}>deploy it</a> or use the <a href={demo}>live demo</a>.</p>
				</div>
			</section>

			<!-- Rolling feature strip -->
			<section class="ticker-band" aria-label="Features">
				<div class="wrap ticker-head"><span class="eyebrow-plain">What's in the box</span><span class="ticker-legend"><span class="plus-dot"></span>not in webhook.site</span></div>
				<div class="ticker">
					<ul class="ticker-track">
						{[...features, ...features].map((f, i) => (
							<li class={f.plus ? 'tick plus' : 'tick'} aria-hidden={i >= features.length ? 'true' : undefined}>{f.plus && <span class="plus-dot"></span>}{f.t}</li>
						))}
					</ul>
				</div>
			</section>
			<!-- Overview -->
			<section id="overview" class="wrap why">
				<div class="section-head narrow">
					<span class="eyebrow mono">webhook.site has been here ten years. so why look?</span>
					<h2>Three things to try in your first minute.</h2>
					<p class="sub">Testing a webhook is mostly poking at it: change a field, fail on purpose, see what the sender does. Elsewhere that needs a paid plan, a CLI or a config file. Here each one is a click on the live demo, no account, and the same call from curl.</p>
				</div>
				<div class="cards">
					<div class="card">
						<span class="mono tag">01 · the mock</span>
						<h3>Change a payload and see the diff before it ships</h3>
						<p>Open a captured request, click <b class="ink">Test a transform on this</b>, type two lines of JavaScript. The diff updates as you type, it runs against your recent traffic, and nothing is saved until you say so.</p>
					</div>
					<div class="card">
						<span class="mono tag">02 · the reply</span>
						<h3>Make the sender retry, on purpose</h3>
						<p>Script a <span class="mono sm ink">500</span> reply and watch the provider's retry arrive. Then return <span class="mono sm ink">200</span>. You just tested your error handling without touching your app, and it cost nothing.</p>
					</div>
					<div class="card card-strong">
						<span class="mono tag accent">03 · the tunnel</span>
						<h3>Watch your localhost answer the provider</h3>
						<p>Point forwarding at <span class="mono sm ink">localhost</span>, turn on the local reply. The provider gets your handler's real status and body, through your browser tab. No CLI, daemon or account.</p>
					</div>
				</div>
				<p class="why-note">The one-liners above run Testhooks on your machine, which is enough to try it with curl. Real providers can only deliver to a URL they can reach, so for those <a href={`${base}deployment/production/`}>deploy it on a server or PaaS with a public URL</a>.</p>
			</section>

			<!-- Modes -->
			<section id="modes" class="wrap modes">
				<div class="panel">
					<div class="panel-head">
						<div class="section-head">
							<span class="eyebrow mono">How it works</span>
							<h2>Two modes. Pick your trade-off.</h2>
						</div>
						<div class="seg seg-lg" role="group" aria-label="Mode" data-tabs="mode">
							<button type="button" class="seg-btn" aria-pressed="false" data-panel="server">Server mode</button>
							<button type="button" class="seg-btn" aria-pressed="true" data-panel="browser">Browser mode</button>
						</div>
					</div>

					<div class="mode" data-mode="server" hidden>
						<div class="mode-intro">
							<h3>The server does the work. Always on.</h3>
							<p>Every request is stored, transformed and forwarded on the server. Your browser is only a viewer, so it keeps working with no tab open.</p>
						</div>
						<div class="flow">
							<div class="step"><span class="mono tag">01</span><b>Webhook sender</b><span>Any service that sends webhooks.</span></div>
							<div class="hop"><span class="mono">HTTP POST</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></div>
							<div class="step step-dark"><span class="mono tag bright">02 · does the work</span><b>Testhooks server</b><span>Receives at <span class="mono sm">/h/:slug</span>, stores it, runs the transform.</span></div>
							<div class="hop"><span class="mono">forward</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></div>
							<div class="step step-accent"><span class="mono tag accent">03</span><b>Any URL</b><span>Sync or async, with retries.</span></div>
							<div class="hop"><span class="mono">view</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="3 3" aria-hidden="true" set:html={arrow} /></div>
							<div class="step step-dashed"><span class="mono tag">optional</span><b>Your browser</b><span>Only a viewer. Close it and nothing stops.</span></div>
						</div>
						<div class="facts">
							<div><h4>Stored on the server</h4><p>In PostgreSQL, or in memory with an optional snapshot file saved every 30 s and on shutdown.</p></div>
							<div><h4>Headless transforms and forwarding</h4><p>JavaScript transforms run on the server, then the request is forwarded to the configured URL.</p></div>
							<div><h4>Custom responses</h4><p>The sender gets back the exact response you scripted.</p></div>
						</div>
						<p class="use-for"><b>Use it for</b> shared or long-running instances, and anything that must keep working with no tab open.</p>
					</div>

					<div class="mode" data-mode="browser">
						<div class="mode-intro">
							<h3>Your browser is the tunnel. Both ways.</h3>
							<p>The server holds the provider's request open and streams it to your tab over WebSocket. Your tab runs the transform, delivers with fetch() to localhost, and sends your app's reply back. The provider sees that reply.</p>
						</div>
						<div class="flow">
							<div class="step"><span class="mono tag">01</span><b>Webhook sender</b><span>Any service that sends webhooks.</span></div>
							<div class="hop"><span class="mono">HTTP POST</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></div>
							<div class="step"><span class="mono tag">02</span><b>Testhooks server</b><span>Receives at <span class="mono sm">/h/:slug</span> and relays it. Keeps only a short in-memory buffer.</span></div>
							<div class="hop"><span class="mono">WebSocket</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></div>
							<div class="step step-dark"><span class="mono tag bright">03 · the tunnel</span><b>Your browser tab</b><span>Runs the transform, delivers with fetch(), waits for the reply.</span></div>
							<div class="hop"><span class="mono">fetch() ⇄ reply</span><svg width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></div>
							<div class="step step-accent"><span class="mono tag accent">04</span><b class="mono">localhost</b><span>Your app answers. Its status and body travel back to the sender.</span></div>
						</div>
						<div class="facts">
							<div><h4>The server only relays</h4><p>Transforms and forwarding run in your tab, which is how it reaches localhost, Docker and anything else your machine can see.</p></div>
							<div><h4>Your app's reply reaches the sender</h4><p>Turn on <b class="ink">Reply to the sender with my app's response</b>. A 200 marks the delivery done; a 500 makes the provider retry, as in production.</p></div>
							<div><h4>Nothing stored unless you ask</h4><p>Payloads never touch the server's disk. Turn on <b class="ink">Persist requests</b> to keep a copy.</p></div>
						</div>
						<div class="example">
							<h4>Example: your receiver only runs on localhost</h4>
							<ol>
								<li><span class="num mono">1</span><span>Create an endpoint on the live demo or your own Testhooks and paste its <span class="mono sm ink">/h/:slug</span> URL into the provider's webhook settings.</span></li>
								<li><span class="num mono">2</span><span>In the tab, set forward to <span class="mono sm ink">http://localhost:[port]/[path]</span> and turn on the local reply.</span></li>
								<li><span class="num mono">3</span><span>Trigger the event. It lands in your tab and on your local server, and the provider gets your handler's reply.</span></li>
							</ol>
						</div>
					</div>
				</div>
			</section>

			<!-- Standard Webhooks -->
			<section id="standard" class="band">
				<div class="wrap standard">
					<div class="standard-copy">
						<span class="eyebrow mono">Standard Webhooks</span>
						<h2>Verify signatures like a real receiver.</h2>
						<p class="sub">Testhooks checks Standard Webhooks signatures from Sparrow, Svix and other senders that follow the spec. Turn on enforcement and bad signatures are rejected, so you test the same path production takes.</p>
						<ul class="checks">
							<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} /><span>Reads the spec headers: <span class="mono chip">webhook-id</span> <span class="mono chip">webhook-timestamp</span> <span class="mono chip">webhook-signature</span></span></li>
							<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} /><span>Can reject invalid signatures with 401 instead of accepting everything</span></li>
							<li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} /><span>Works with Sparrow, Svix and other compliant senders</span></li>
						</ul>
					</div>
					<div class="request">
						<div class="request-head"><span class="mono"><span class="bright">POST</span> /h/[your-slug]</span><span class="mono dim">example request</span></div>
						<div class="request-body mono">
							<div><span class="key">webhook-id:</span> msg_[id]</div>
							<div><span class="key">webhook-timestamp:</span> [unix-seconds]</div>
							<div><span class="key">webhook-signature:</span> v1,[base64-signature]</div>
						</div>
						<div class="verdicts">
							<div class="verdict ok"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5BD08F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />Signature valid: accepted and forwarded</div>
							<div class="verdict bad"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>Signature mismatch: rejected, like a real receiver</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Features -->
			<section id="features" class="band band-surface">
				<div class="wrap features">
					<div class="features-head">
						<h2>Everything you need to test a webhook. Nothing you don't.</h2>
						<p class="sub">Not a webhook server, not a gateway: one Go binary with the UI embedded. Every screen is a REST call you can make with curl. Storage is PostgreSQL, or memory for local testing.</p>
					</div>
					<div class="grid">
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg><h3>Replace the tunnel</h3><p>Forward from your tab to localhost, Docker or anything your machine reaches, and the sender gets your app's reply. No CLI, daemon or account.</p></div>
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg><h3>Private by default</h3><p>In browser mode, payloads are relayed over WebSocket and never written to the server's disk.</p></div>
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg><h3>Live inspection</h3><p>Every request appears the instant it arrives: headers, query, body with syntax highlighting. Copy as cURL, export as JSON.</p></div>
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6l-6 6 6 6M16 6l6 6-6 6"></path></svg><h3>Script transforms</h3><p>Reshape payloads with a few lines of JavaScript, sandboxed in WASM, before they are forwarded.</p></div>
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h12M12 6l6 6-6 6M20 5v14"></path></svg><h3>Forward and mock</h3><p>Forward to any URL, sync or async with retries, and script the exact response the sender gets back.</p></div>
						<div class="feature"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"></path><path d="M8.5 12l2.5 2.5L15.5 10"></path></svg><h3>Verify signatures</h3><p>Check Standard Webhooks signatures from Sparrow, Svix and others, and reject bad ones like a real receiver.</p></div>
