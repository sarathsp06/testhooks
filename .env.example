# Testhooks — Environment Variables
# Copy to .env and adjust as needed. All values shown are defaults.

# Listen address for the HTTP server.
LISTEN=:8080

# PORT overrides LISTEN when set (standard PaaS convention: ":<PORT>").
# PORT=

# Storage. "memory" (the default) needs no database: data is lost on restart
# unless SNAPSHOT_PATH is set. Use PostgreSQL for shared or long-running
# instances, e.g.:
# DATABASE_URL=postgres://testhooks:testhooks@localhost:5432/testhooks?sslmode=disable
DATABASE_URL=memory

# With DATABASE_URL=memory: file the data is saved to every 30s and on
# shutdown, and loaded from on start. Empty keeps data in memory only.
# SNAPSHOT_PATH=./testhooks.snapshot

# Dev mode: proxy SPA requests to the Vite dev server.
DEV=false

# Vite dev server URL (used when DEV=true).
VITE_URL=http://localhost:5173

# Max body size in bytes for captured webhook requests (default 512KB).
MAX_BODY_SIZE=524288

# Max total body storage in bytes per endpoint — oldest requests are pruned
# when an endpoint exceeds this budget (default 10MB).
MAX_ENDPOINT_STORAGE_BYTES=10485760

# Max requests stored per endpoint — oldest are pruned beyond this count.
MAX_REQUESTS_PER_ENDPOINT=500

# Background pruner interval in seconds.
PRUNE_INTERVAL_SECONDS=60

# A sentence shown under the storage limits in the UI saying what a paid plan
# would lift, with an "I'd pay for that" button the server counts (one per
# browser). Leave empty to show the limits only.
# UPGRADE_NOTE=A paid plan would keep 10,000 requests for 30 days.

# Ring buffer size for browser-mode endpoints (in-memory, per endpoint).
RING_BUFFER_SIZE=100

# Rate limit: sustained requests per second per IP on capture endpoints.
# Set to 0 to disable rate limiting.
RATE_LIMIT_RPS=20

# Rate limit: maximum burst size per IP.
RATE_LIMIT_BURST=40

# Headers removed from captured requests before they are stored, shown or
# forwarded. "*" suffix matches a prefix; "default" is Vercel's credentials
# (OIDC token, proxy signature), plus Forwarded on Vercel; "none" strips nothing.
# STRIP_HEADERS=default,X-Internal-*

# Let server-side forwarding reach private addresses (10.x, 192.168.x, ...)
# and this server's localhost. Only for a server you run inside your own
# network; never on one the public can use. Metadata addresses stay blocked.
# ALLOW_PRIVATE_FORWARD_TARGETS=true

# Key encryption keys for signature secrets stored at rest, "<id>=<64 hex>".
# Generate with: openssl rand -hex 32. To rotate, add a new key, set it as
# primary and restart (secrets are rewrapped), then remove the old one.
# ENCRYPTION_KEYS=k1=<64 hex characters>
# ENCRYPTION_PRIMARY_KEY_ID=k1
